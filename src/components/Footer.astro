---
import { Icon } from "astro-icon/components";

const year = new Date().getFullYear();

const github = "https://github.com/MoeStdio";
const discordHandle = "_catcat.";
---

<footer class="py-8 px-6 text-center bg-slate-200 dark:bg-neutral-950 snap-target border-t border-slate-300 dark:border-transparent">
  <div class="flex justify-center items-center gap-8 flex-wrap">
    <a
      href="/contact"
      aria-label="Contact Page"
      class="flex items-center gap-2 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
    >
      <Icon name="lucide:mail" class="w-5 h-5" />
      <span>Contact</span>
    </a>

    <a
      href={github}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub profile"
      class="flex items-center gap-2 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors"
    >
      <Icon name="simple-icons:github" class="w-5 h-5" />
      <span>GitHub</span>
    </a>

    <span
      aria-label="Discord username"
      class="flex items-center gap-2 text-slate-600 dark:text-slate-300"
    >
      <Icon name="simple-icons:discord" class="w-5 h-5" />
      <span>{discordHandle}</span>
    </span>
  </div>

  <div class="w-16 h-px bg-slate-300 dark:bg-white/15 mx-auto my-6"></div>

  <p class="text-sm text-slate-500 dark:text-slate-400">© {year} moestdio. All rights reserved.</p>
</footer>