---
const { text, color = 'slate' } = Astro.props;

// Tailwind safe color mapping for hover and active (mobile touch) states
const colorMap = {
    indigo: 'hover:border-indigo-400 active:border-indigo-400 hover:shadow-[0_0_10px_rgba(129,140,248,0.4)] hover:text-indigo-300 active:text-indigo-300',
    cyan: 'hover:border-cyan-400 active:border-cyan-400 hover:shadow-[0_0_10px_rgba(34,211,238,0.4)] hover:text-cyan-300 active:text-cyan-300',
    emerald: 'hover:border-emerald-400 active:border-emerald-400 hover:shadow-[0_0_10px_rgba(52,211,153,0.4)] hover:text-emerald-300 active:text-emerald-300',
    amber: 'hover:border-amber-400 active:border-amber-400 hover:shadow-[0_0_10px_rgba(251,191,36,0.4)] hover:text-amber-300 active:text-amber-300',
    slate: 'hover:border-slate-400 active:border-slate-400 hover:shadow-[0_0_10px_rgba(148,163,184,0.4)] hover:text-white active:text-white'
};

const hoverStyles = colorMap[color] || colorMap.slate;
---
<span tabindex="0" class={`inline-block px-3 py-1.5 md:px-4 md:py-2 rounded-full bg-slate-800/80 text-slate-300 border border-slate-700 text-xs md:text-sm font-medium transition-all duration-300 cursor-pointer hover:-translate-y-1 active:-translate-y-1 focus:outline-none select-none backdrop-blur-sm ${hoverStyles}`}>
    {text || <slot />}
</span>
