---
const { text, color = 'slate' } = Astro.props;

const colorMap: Record<string, string> = {
    indigo: "hover:bg-indigo-50 active:bg-indigo-50 hover:text-indigo-600 active:text-indigo-600 hover:border-indigo-200 active:border-indigo-200 dark:hover:bg-indigo-500/20 dark:active:bg-indigo-500/20 dark:hover:text-indigo-300 dark:active:text-indigo-300 dark:hover:border-indigo-500/50 dark:active:border-indigo-500/50",
    cyan: "hover:bg-cyan-50 active:bg-cyan-50 hover:text-cyan-600 active:text-cyan-600 hover:border-cyan-200 active:border-cyan-200 dark:hover:bg-cyan-500/20 dark:active:bg-cyan-500/20 dark:hover:text-cyan-300 dark:active:text-cyan-300 dark:hover:border-cyan-500/50 dark:active:border-cyan-500/50",
    emerald: "hover:bg-emerald-50 active:bg-emerald-50 hover:text-emerald-600 active:text-emerald-600 hover:border-emerald-200 active:border-emerald-200 dark:hover:bg-emerald-500/20 dark:active:bg-emerald-500/20 dark:hover:text-emerald-300 dark:active:text-emerald-300 dark:hover:border-emerald-500/50 dark:active:border-emerald-500/50",
    amber: "hover:bg-amber-50 active:bg-amber-50 hover:text-amber-600 active:text-amber-600 hover:border-amber-200 active:border-amber-200 dark:hover:bg-amber-500/20 dark:active:bg-amber-500/20 dark:hover:text-amber-300 dark:active:text-amber-300 dark:hover:border-amber-500/50 dark:active:border-amber-500/50",
    slate: "hover:bg-slate-100 active:bg-slate-100 hover:text-slate-700 active:text-slate-700 hover:border-slate-300 active:border-slate-300 dark:hover:bg-slate-700/50 dark:active:bg-slate-700/50 dark:hover:text-slate-200 dark:active:text-slate-200 dark:hover:border-slate-600 dark:active:border-slate-600",
    rose: "hover:bg-rose-50 active:bg-rose-50 hover:text-rose-600 active:text-rose-600 hover:border-rose-200 active:border-rose-200 dark:hover:bg-rose-500/20 dark:active:bg-rose-500/20 dark:hover:text-rose-300 dark:active:text-rose-300 dark:hover:border-rose-500/50 dark:active:border-rose-500/50",
    fuchsia: "hover:bg-fuchsia-50 active:bg-fuchsia-50 hover:text-fuchsia-600 active:text-fuchsia-600 hover:border-fuchsia-200 active:border-fuchsia-200 dark:hover:bg-fuchsia-500/20 dark:active:bg-fuchsia-500/20 dark:hover:text-fuchsia-300 dark:active:text-fuchsia-300 dark:hover:border-fuchsia-500/50 dark:active:border-fuchsia-500/50",
    violet: "hover:bg-violet-50 active:bg-violet-50 hover:text-violet-600 active:text-violet-600 hover:border-violet-200 active:border-violet-200 dark:hover:bg-violet-500/20 dark:active:bg-violet-500/20 dark:hover:text-violet-300 dark:active:text-violet-300 dark:hover:border-violet-500/50 dark:active:border-violet-500/50",
    sky: "hover:bg-sky-50 active:bg-sky-50 hover:text-sky-600 active:text-sky-600 hover:border-sky-200 active:border-sky-200 dark:hover:bg-sky-500/20 dark:active:bg-sky-500/20 dark:hover:text-sky-300 dark:active:text-sky-300 dark:hover:border-sky-500/50 dark:active:border-sky-500/50",
    lime: "hover:bg-lime-50 active:bg-lime-50 hover:text-lime-600 active:text-lime-600 hover:border-lime-200 active:border-lime-200 dark:hover:bg-lime-500/20 dark:active:bg-lime-500/20 dark:hover:text-lime-300 dark:active:text-lime-300 dark:hover:border-lime-500/50 dark:active:border-lime-500/50",
    orange: "hover:bg-orange-50 active:bg-orange-50 hover:text-orange-600 active:text-orange-600 hover:border-orange-200 active:border-orange-200 dark:hover:bg-orange-500/20 dark:active:bg-orange-500/20 dark:hover:text-orange-300 dark:active:text-orange-300 dark:hover:border-orange-500/50 dark:active:border-orange-500/50",
};

const hoverStyles = colorMap[color] || colorMap.slate;
---
<span tabindex="0" class={`inline-block px-3 py-1.5 md:px-4 md:py-2 rounded-full bg-white dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 text-xs md:text-sm font-medium transition-all duration-300 cursor-pointer hover:-translate-y-1 active:scale-95 focus:outline-none select-none backdrop-blur-sm [-webkit-tap-highlight-color:transparent] ${hoverStyles}`}>
    {text || <slot />}
</span>
