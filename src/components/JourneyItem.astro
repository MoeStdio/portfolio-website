---
const { year, role, company, description, color = 'indigo' } = Astro.props;

// Tailwind safe color mapping for hover and active states
const colorMap = {
    indigo: {
        dot: 'group-hover:bg-indigo-400 group-active:bg-indigo-400 group-hover:shadow-[0_0_15px_rgba(129,140,248,0.5)] group-active:shadow-[0_0_15px_rgba(129,140,248,0.5)]',
        yearText: 'text-indigo-400'
    },
    cyan: {
        dot: 'group-hover:bg-cyan-400 group-active:bg-cyan-400 group-hover:shadow-[0_0_15px_rgba(34,211,238,0.5)] group-active:shadow-[0_0_15px_rgba(34,211,238,0.5)]',
        yearText: 'text-cyan-400'
    },
    emerald: {
        dot: 'group-hover:bg-emerald-400 group-active:bg-emerald-400 group-hover:shadow-[0_0_15px_rgba(52,211,153,0.5)] group-active:shadow-[0_0_15px_rgba(52,211,153,0.5)]',
        yearText: 'text-emerald-400'
    },
    amber: {
        dot: 'group-hover:bg-amber-400 group-active:bg-amber-400 group-hover:shadow-[0_0_15px_rgba(251,191,36,0.5)] group-active:shadow-[0_0_15px_rgba(251,191,36,0.5)]',
        yearText: 'text-amber-400'
    }
};

const styles = colorMap[color] || colorMap.indigo;
---
<div tabindex="0" class="relative group cursor-pointer focus:outline-none">
    <div class={`absolute -left-[29px] md:-left-[45px] top-1.5 w-4 h-4 rounded-full bg-slate-600 group-hover:scale-125 group-active:scale-125 transition-all duration-300 ${styles.dot}`}></div>
    <span class={`font-bold text-xs md:text-sm tracking-widest uppercase mb-1 block ${styles.yearText}`}>{year}</span>
    <h3 class="text-xl md:text-2xl font-bold text-slate-100 mb-0.5 md:mb-1">{role}</h3>
    <h4 class="text-base md:text-lg font-medium text-slate-400 mb-2 md:mb-4">{company}</h4>
    <p class="text-sm md:text-base text-slate-300 leading-snug md:leading-relaxed group-hover:text-slate-100 group-active:text-slate-100 transition-colors">
        {description}
    </p>
</div>
