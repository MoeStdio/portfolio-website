---
const { year, role, company, description, color = 'indigo' } = Astro.props;

const colorMap: Record<string, {dot: string, yearText: string}> = {
    indigo: { dot: 'group-hover:bg-indigo-500 group-active:bg-indigo-500 group-hover:shadow-[0_0_15px_rgba(99,102,241,0.5)] group-active:shadow-[0_0_15px_rgba(99,102,241,0.5)]', yearText: 'text-indigo-600 dark:text-indigo-400' },
    cyan: { dot: 'group-hover:bg-cyan-500 group-active:bg-cyan-500 group-hover:shadow-[0_0_15px_rgba(6,182,212,0.5)] group-active:shadow-[0_0_15px_rgba(6,182,212,0.5)]', yearText: 'text-cyan-600 dark:text-cyan-400' },
    emerald: { dot: 'group-hover:bg-emerald-500 group-active:bg-emerald-500 group-hover:shadow-[0_0_15px_rgba(16,185,129,0.5)] group-active:shadow-[0_0_15px_rgba(16,185,129,0.5)]', yearText: 'text-emerald-600 dark:text-emerald-400' },
    amber: { dot: 'group-hover:bg-amber-500 group-active:bg-amber-500 group-hover:shadow-[0_0_15px_rgba(245,158,11,0.5)] group-active:shadow-[0_0_15px_rgba(245,158,11,0.5)]', yearText: 'text-amber-600 dark:text-amber-400' },
    rose: { dot: 'group-hover:bg-rose-500 group-active:bg-rose-500 group-hover:shadow-[0_0_15px_rgba(244,63,94,0.5)] group-active:shadow-[0_0_15px_rgba(244,63,94,0.5)]', yearText: 'text-rose-600 dark:text-rose-400' },
    fuchsia: { dot: 'group-hover:bg-fuchsia-500 group-active:bg-fuchsia-500 group-hover:shadow-[0_0_15px_rgba(217,70,239,0.5)] group-active:shadow-[0_0_15px_rgba(217,70,239,0.5)]', yearText: 'text-fuchsia-600 dark:text-fuchsia-400' },
    violet: { dot: 'group-hover:bg-violet-500 group-active:bg-violet-500 group-hover:shadow-[0_0_15px_rgba(139,92,246,0.5)] group-active:shadow-[0_0_15px_rgba(139,92,246,0.5)]', yearText: 'text-violet-600 dark:text-violet-400' },
    sky: { dot: 'group-hover:bg-sky-500 group-active:bg-sky-500 group-hover:shadow-[0_0_15px_rgba(14,165,233,0.5)] group-active:shadow-[0_0_15px_rgba(14,165,233,0.5)]', yearText: 'text-sky-600 dark:text-sky-400' },
    lime: { dot: 'group-hover:bg-lime-500 group-active:bg-lime-500 group-hover:shadow-[0_0_15px_rgba(132,204,22,0.5)] group-active:shadow-[0_0_15px_rgba(132,204,22,0.5)]', yearText: 'text-lime-600 dark:text-lime-400' },
    orange: { dot: 'group-hover:bg-orange-500 group-active:bg-orange-500 group-hover:shadow-[0_0_15px_rgba(249,115,22,0.5)] group-active:shadow-[0_0_15px_rgba(249,115,22,0.5)]', yearText: 'text-orange-600 dark:text-orange-400' },
};

const styles = colorMap[color] || colorMap.indigo;
---
<div tabindex="0" class="reveal relative group cursor-pointer focus:outline-none [-webkit-tap-highlight-color:transparent]">
    <div class={`absolute -left-[29px] md:-left-[45px] top-1.5 w-4 h-4 rounded-full bg-slate-300 dark:bg-slate-600 group-hover:scale-125 group-active:scale-125 transition-all duration-300 ${styles.dot}`}></div>
    <span class={`font-bold text-xs md:text-sm tracking-widest uppercase mb-1 block ${styles.yearText}`}>{year}</span>
    <h3 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-slate-100 mb-0.5 md:mb-1">{role}</h3>
    <h4 class="text-base md:text-lg font-medium text-slate-600 dark:text-slate-400 mb-2 md:mb-4">{company}</h4>
    <p class="text-sm md:text-base text-slate-600 dark:text-slate-300 leading-snug md:leading-relaxed group-hover:text-slate-900 dark:group-hover:text-slate-100 group-active:text-slate-900 dark:group-active:text-slate-100 transition-colors">
        {description}
    </p>
</div>
