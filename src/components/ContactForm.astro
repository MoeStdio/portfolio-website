---
import { Icon } from "astro-icon/components";
---

<form
    class="bg-white/60 dark:bg-slate-800/40 backdrop-blur-md border border-slate-200/80 dark:border-slate-700/50 rounded-3xl p-4 md:p-8 shadow-2xl flex flex-col gap-4 md:gap-6"
    onsubmit="event.preventDefault();"
>
    <div class="reveal flex flex-col gap-4">
        <label
            class="text-slate-700 dark:text-slate-300 font-medium text-sm ml-2 uppercase tracking-wider"
            >How can I help you?</label
        >
        <div class="flex flex-wrap gap-3">
            <label class="cursor-pointer">
                <input
                    type="radio"
                    name="category"
                    value="job"
                    class="peer sr-only"
                    checked
                />
                <span
                    class="inline-block px-4 py-2 md:px-6 md:py-3 rounded-full bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-400 border border-slate-300 dark:border-slate-700 text-sm md:text-base font-medium transition-all duration-300 peer-checked:bg-indigo-100 dark:peer-checked:bg-indigo-500/20 peer-checked:text-indigo-600 dark:peer-checked:text-indigo-300 peer-checked:border-indigo-500/50 hover:bg-slate-200 dark:hover:bg-slate-700 select-none [-webkit-tap-highlight-color:transparent] active:scale-95"
                >
                    Job Opportunity
                </span>
            </label>

            <label class="cursor-pointer">
                <input
                    type="radio"
                    name="category"
                    value="freelance"
                    class="peer sr-only"
                />
                <span
                    class="inline-block px-4 py-2 md:px-6 md:py-3 rounded-full bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-400 border border-slate-300 dark:border-slate-700 text-sm md:text-base font-medium transition-all duration-300 peer-checked:bg-cyan-100 dark:peer-checked:bg-cyan-500/20 peer-checked:text-cyan-600 dark:peer-checked:text-cyan-300 peer-checked:border-cyan-500/50 hover:bg-slate-200 dark:hover:bg-slate-700 select-none [-webkit-tap-highlight-color:transparent] active:scale-95"
                >
                    Freelance
                </span>
            </label>

            <label class="cursor-pointer">
                <input
                    type="radio"
                    name="category"
                    value="collaboration"
                    class="peer sr-only"
                />
                <span
                    class="inline-block px-4 py-2 md:px-6 md:py-3 rounded-full bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-400 border border-slate-300 dark:border-slate-700 text-sm md:text-base font-medium transition-all duration-300 peer-checked:bg-emerald-100 dark:peer-checked:bg-emerald-500/20 peer-checked:text-emerald-600 dark:peer-checked:text-emerald-300 peer-checked:border-emerald-500/50 hover:bg-slate-200 dark:hover:bg-slate-700 select-none [-webkit-tap-highlight-color:transparent] active:scale-95"
                >
                    Collaboration
                </span>
            </label>

            <label class="cursor-pointer">
                <input
                    type="radio"
                    name="category"
                    value="general"
                    class="peer sr-only"
                />
                <span
                    class="inline-block px-4 py-2 md:px-6 md:py-3 rounded-full bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-400 border border-slate-300 dark:border-slate-700 text-sm md:text-base font-medium transition-all duration-300 peer-checked:bg-slate-200 dark:peer-checked:bg-slate-500/20 peer-checked:text-slate-800 dark:peer-checked:text-slate-300 peer-checked:border-slate-400 dark:peer-checked:border-slate-500/50 hover:bg-slate-200 dark:hover:bg-slate-700 select-none [-webkit-tap-highlight-color:transparent] active:scale-95"
                >
                    General Inquiry
                </span>
            </label>
        </div>
    </div>

    <div class="reveal flex flex-col md:flex-row gap-4 md:gap-6">
        <div class="flex-1 flex flex-col gap-2">
            <label
                for="name"
                class="text-slate-700 dark:text-slate-300 font-medium text-sm ml-2"
                >Name</label
            >
            <input
                type="text"
                id="name"
                name="name"
                placeholder="John Doe"
                class="w-full bg-slate-50/60 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-200 px-4 py-3 md:px-5 md:py-4 rounded-2xl focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all placeholder:text-slate-400 dark:placeholder:text-slate-600"
                required
            />
        </div>
        <div class="flex-1 flex flex-col gap-2">
            <label
                for="email"
                class="text-slate-700 dark:text-slate-300 font-medium text-sm ml-2"
                >Email</label
            >
            <input
                type="email"
                id="email"
                name="email"
                placeholder="john@example.com"
                class="w-full bg-slate-50/60 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-200 px-4 py-3 md:px-5 md:py-4 rounded-2xl focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all placeholder:text-slate-400 dark:placeholder:text-slate-600"
                required
            />
        </div>
    </div>

    <div class="reveal flex flex-col gap-2">
        <label
            for="message"
            class="text-slate-700 dark:text-slate-300 font-medium text-sm ml-2"
            >Message</label
        >
        <textarea
            id="message"
            name="message"
            rows="3"
            placeholder="Tell me about the role, company, and expectations..."
            class="w-full bg-slate-50/60 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-200 px-4 py-3 md:px-5 md:py-4 rounded-2xl focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all placeholder:text-slate-400 dark:placeholder:text-slate-600 resize-none"
            required></textarea>
    </div>

    <div class="reveal pt-4">
        <button
            type="submit"
            class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-6 py-3 md:px-8 md:py-4 rounded-full transition-all duration-300 hover:shadow-[0_0_20px_rgba(79,70,229,0.4)] active:scale-95 focus:outline-none flex justify-center items-center gap-3 group [-webkit-tap-highlight-color:transparent]"
        >
            Submit Ticket
            <Icon
                name="lucide:send"
                class="w-5 h-5 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"
            />
        </button>
    </div>
</form>

<script>
    const setupForm = () => {
        const messageInput = document.getElementById("message") as HTMLTextAreaElement | null;
        const radios = document.querySelectorAll('input[name="category"]');

        if (!messageInput || radios.length === 0) return;

        const placeholders: Record<string, string> = {
            job: "Tell me about the role, company, and expectations...",
            freelance: "What's the scope and timeline of your project?",
            collaboration: "What are we building together?",
            general: "How can I help you today?",
        };

        radios.forEach((radio) => {
            radio.addEventListener("change", (e) => {
                const target = e.target as HTMLInputElement;
                if (target.checked && placeholders[target.value]) {
                    messageInput.placeholder = placeholders[target.value];
                }
            });
        });
    };

    setupForm();
    document.addEventListener("astro:page-load", setupForm);
</script>
