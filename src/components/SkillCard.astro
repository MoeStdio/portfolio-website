---
import { Icon } from "astro-icon/components";

const { title, description, icon, color = 'indigo', rotation = 'rotate' } = Astro.props;

const colorMap: Record<string, {wrapper: string, iconBg: string}> = {
    indigo: { wrapper: 'hover:border-indigo-500 active:border-indigo-500 hover:shadow-indigo-500/10 active:shadow-indigo-500/10', iconBg: 'group-hover:bg-indigo-500 group-active:bg-indigo-500' },
    cyan: { wrapper: 'hover:border-cyan-500 active:border-cyan-500 hover:shadow-cyan-500/10 active:shadow-cyan-500/10', iconBg: 'group-hover:bg-cyan-500 group-active:bg-cyan-500' },
    emerald: { wrapper: 'hover:border-emerald-500 active:border-emerald-500 hover:shadow-emerald-500/10 active:shadow-emerald-500/10', iconBg: 'group-hover:bg-emerald-500 group-active:bg-emerald-500' },
    amber: { wrapper: 'hover:border-amber-500 active:border-amber-500 hover:shadow-amber-500/10 active:shadow-amber-500/10', iconBg: 'group-hover:bg-amber-500 group-active:bg-amber-500' },
    rose: { wrapper: 'hover:border-rose-500 active:border-rose-500 hover:shadow-rose-500/10 active:shadow-rose-500/10', iconBg: 'group-hover:bg-rose-500 group-active:bg-rose-500' },
    fuchsia: { wrapper: 'hover:border-fuchsia-500 active:border-fuchsia-500 hover:shadow-fuchsia-500/10 active:shadow-fuchsia-500/10', iconBg: 'group-hover:bg-fuchsia-500 group-active:bg-fuchsia-500' },
    violet: { wrapper: 'hover:border-violet-500 active:border-violet-500 hover:shadow-violet-500/10 active:shadow-violet-500/10', iconBg: 'group-hover:bg-violet-500 group-active:bg-violet-500' },
    sky: { wrapper: 'hover:border-sky-500 active:border-sky-500 hover:shadow-sky-500/10 active:shadow-sky-500/10', iconBg: 'group-hover:bg-sky-500 group-active:bg-sky-500' },
    lime: { wrapper: 'hover:border-lime-500 active:border-lime-500 hover:shadow-lime-500/10 active:shadow-lime-500/10', iconBg: 'group-hover:bg-lime-500 group-active:bg-lime-500' },
    orange: { wrapper: 'hover:border-orange-500 active:border-orange-500 hover:shadow-orange-500/10 active:shadow-orange-500/10', iconBg: 'group-hover:bg-orange-500 group-active:bg-orange-500' },
};

const rotClass = rotation === 'rotate' ? 'group-hover:rotate-6 group-active:rotate-6' : 'group-hover:-rotate-6 group-active:-rotate-6';
const styles = colorMap[color] || colorMap.indigo;
---
<div tabindex="0" class={`h-full reveal bg-white dark:bg-slate-800/50 p-4 md:p-8 rounded-2xl md:rounded-3xl border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 active:bg-slate-100 dark:active:bg-slate-800 transition-all duration-300 hover:-translate-y-2 active:scale-95 cursor-pointer group text-center shadow-sm dark:shadow-xl flex flex-col items-center focus:outline-none [-webkit-tap-highlight-color:transparent] ${styles.wrapper}`}>
    <div class={`w-10 h-10 md:w-16 md:h-16 bg-slate-100 dark:bg-slate-700 rounded-xl md:rounded-2xl flex items-center justify-center mb-3 md:mb-6 transition-all duration-300 ${styles.iconBg} ${rotClass}`}>
        <Icon name={icon} class="w-5 h-5 md:w-8 md:h-8 text-slate-500 dark:text-slate-300 group-hover:text-white group-active:text-white transition-colors" />
    </div>
    <h3 class="font-bold text-sm md:text-xl mb-1 md:mb-3 text-slate-900 dark:text-slate-100">{title}</h3>
    <p class="text-[10px] md:text-sm text-slate-500 dark:text-slate-400 leading-snug md:leading-relaxed line-clamp-3 md:line-clamp-none">{description}</p>
</div>
