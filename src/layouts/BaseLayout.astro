---
import '../styles/global.css'
import Footer from '../components/Footer.astro'
import { Icon } from "astro-icon/components"

const { title } = Astro.props;
---

<html lang="en" dir="ltr">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>{title}</title>
        <link rel="icon" href="/image.png" type="image/png">
    </head>

    <body class="bg-slate-700 text-slate-100 font-sans [&::-webkit-scrollbar]:hidden">
        <header class="fixed w-full top-0 z-50 bg-slate-800/80 backdrop-blur-md">
            <nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
                <a href="/" class="flex items-center">
                    <img src="/image.png" alt="moestdio logo" decoding="async" class="h-10 w-auto hover:opacity-80 transition-opacity"/>
                </a>

                <ul class="flex items-center gap-8">
                    <li>
                        <a class="text-sm font-medium text-slate-300 hover:text-white transition-colors" href="/">Home</a>
                    </li>
                    <li>
                        <a class="text-sm font-medium text-slate-300 hover:text-white transition-colors" href="/about">About</a>
                    </li>
                    <li>
                        <a class="text-sm font-medium text-slate-300 hover:text-white transition-colors" href="/projects">Projects</a>
                    </li>
                </ul>

            </nav>
        </header>

        <slot />
        <Footer />
        
        <div id="scroll-indicator" class="fixed bottom-8 left-1/2 -translate-x-1/2 z-40 transition-opacity duration-300 opacity-50 animate-bounce pointer-events-none">
            <Icon name="lucide:chevron-down" class="w-8 h-8 text-white drop-shadow-md" />
        </div>

        <script>
            import '../scripts/smooth-scroll.js'
        </script>
    </body>
</html>