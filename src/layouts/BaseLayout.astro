---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";

const { title } = Astro.props;
---

<html lang="en" dir="ltr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="color-scheme" content="light dark" />
        <title>{title}</title>
        <link rel="icon" href="/logo.svg" type="image/svg" />
        <script is:inline>
            const theme = (() => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                    return "dark";
                }
                return "light";
            })();
            if (theme === "light") {
                document.documentElement.classList.remove("dark");
            } else {
                document.documentElement.classList.add("dark");
            }
            window.localStorage.setItem("theme", theme);
        </script>
    </head>

    <body
        class="bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 font-sans [&::-webkit-scrollbar]:hidden transition-colors duration-300 selection:bg-indigo-500/30"
    >
        <header
            class="fixed w-full top-0 z-50 bg-white/80 dark:bg-slate-800/80 backdrop-blur-md transition-colors duration-300 border-b border-slate-200 dark:border-transparent"
        >
            <nav
                class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between"
            >
                <a href="/" class="flex items-center">
                    <img
                        src="/logo.svg"
                        alt="moestdio logo"
                        fetchpriority="high"
                        loading="eager"
                        class="h-10 w-auto hover:opacity-80 transition-opacity dark:invert-0 dark:brightness-100 brightness-0"
                    />
                </a>

                <div class="flex items-center gap-6 md:gap-8">
                    <ul class="flex items-center gap-4 md:gap-8">
                        <li>
                            <a
                                class="text-sm font-medium text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors"
                                href="/">Home</a
                            >
                        </li>
                        <li>
                            <a
                                class="text-sm font-medium text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors"
                                href="/about">About</a
                            >
                        </li>
                        <li>
                            <a
                                class="text-sm font-medium text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white transition-colors"
                                href="/projects">Projects</a
                            >
                        </li>
                    </ul>

                    <button
                        id="theme-toggle"
                        type="button"
                        aria-label="Toggle Dark Mode"
                        class="relative overflow-hidden w-16 h-8 rounded-full bg-slate-300 dark:bg-slate-700 flex items-center transition-colors duration-300 focus:outline-none [-webkit-tap-highlight-color:transparent] group shadow-inner"
                    >
                        <div
                            class="absolute inset-0 flex justify-between items-center px-2 pointer-events-none"
                        >
                            <Icon
                                name="lucide:sun"
                                class="w-3.5 h-3.5 text-amber-500/50"
                            />
                            <Icon
                                name="lucide:moon"
                                class="w-3.5 h-3.5 text-indigo-400/50"
                            />
                        </div>

                        <div
                            class="absolute left-1 top-1 w-6 h-6 rounded-full bg-white dark:bg-slate-900 shadow-sm transition-transform duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] dark:translate-x-8 flex items-center justify-center pointer-events-none"
                        >
                            <Icon
                                name="lucide:sun"
                                class="w-3.5 h-3.5 text-amber-500 absolute transition-all duration-500 scale-100 rotate-0 dark:scale-0 dark:-rotate-90"
                            />
                            <Icon
                                name="lucide:moon"
                                class="w-3.5 h-3.5 text-indigo-400 absolute transition-all duration-500 scale-0 rotate-90 dark:scale-100 dark:rotate-0"
                            />
                        </div>
                    </button>

                    <script is:inline>
                        const themeBtn =
                            document.getElementById("theme-toggle");
                        if (themeBtn) {
                            themeBtn.addEventListener("click", () => {
                                const html = document.documentElement;
                                html.classList.toggle("dark");
                                localStorage.setItem(
                                    "theme",
                                    html.classList.contains("dark")
                                        ? "dark"
                                        : "light",
                                );
                            });
                        }
                    </script>
                </div>
            </nav>
        </header>

        <slot />
        <Footer />

        <div
            id="scroll-indicator"
            class="fixed bottom-8 left-1/2 -translate-x-1/2 z-40 transition-opacity duration-300 opacity-50 animate-bounce pointer-events-none"
        >
            <Icon
                name="lucide:chevron-down"
                class="w-8 h-8 text-slate-900 dark:text-white drop-shadow-md"
            />
        </div>

        <script>
            import "../scripts/smooth-scroll.js";
            import "../scripts/reveal.js";
        </script>
    </body>
</html>
