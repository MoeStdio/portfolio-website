---
import BaseLayout from "../layouts/BaseLayout.astro";
import SkillCard from "../components/SkillCard.astro";
import JourneyItem from "../components/JourneyItem.astro";
import Tag from "../components/Tag.astro";
import { Icon } from "astro-icon/components";
---

<BaseLayout title="About | moestdio">
    <main class="min-h-screen pt-16 md:pt-32 touch-none snap-loading">

        <section class="min-h-dvh w-full flex flex-col justify-center snap-center px-6 pt-24 pb-6 md:px-8 md:py-24 relative snap-target">
            <div class="max-w-5xl mx-auto w-full text-center">
                <h1 class="text-[clamp(2.5rem,8vw,6rem)] font-bold mb-6 bg-linear-to-r from-indigo-400 to-cyan-400 bg-clip-text text-transparent">
                    Moe
                </h1>
                <p class="text-[clamp(1.125rem,3vw,1.5rem)] text-slate-300 leading-relaxed max-w-3xl mx-auto mb-12">
                    Something something something, idk what to put here just filling iut out cuz i dont wanna use lorem.
                </p>
                <div class="flex flex-wrap justify-center gap-4">
                    <Tag text="Developer" color="indigo" />
                    <Tag text="Designer" color="cyan" />
                    <Tag text="Creator" color="emerald" />
                </div>
            </div>
        </section>

        <section class="min-h-dvh w-full flex flex-col justify-center snap-center px-4 pt-24 pb-6 md:px-8 md:py-24 relative snap-target">
            <div class="max-w-6xl mx-auto w-full">
                <h2 class="text-[clamp(1.75rem,5vw,4rem)] font-bold mb-6 md:mb-12 text-center text-slate-100">My Toolkit</h2>
                
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-6">
                    <SkillCard 
                        title="Programming"
                        description="(Python, HTML, JS, LuaU)"
                        icon="lucide:code"
                        color="indigo"
                        rotation="rotate"
                    />
                    <SkillCard 
                        title="Web Development"
                        description="idk first website"
                        icon="lucide:layout"
                        color="cyan"
                        rotation="-rotate"
                    />
                    <SkillCard 
                        title="[Skill 3]"
                        description="[no more ideas will think in the future]"
                        icon="lucide:database"
                        color="emerald"
                        rotation="rotate"
                    />
                    <SkillCard 
                        title="[Skill 4]"
                        description="[no more ideas will think in the future]"
                        icon="lucide:zap"
                        color="amber"
                        rotation="-rotate"
                    />
                </div>
            </div>
        </section>

        <section class="min-h-dvh w-full flex flex-col justify-center snap-center px-6 pt-24 pb-6 md:px-8 md:py-24 relative snap-target">
            <div class="max-w-4xl mx-auto w-full">
                <h2 class="text-[clamp(1.75rem,5vw,4rem)] font-bold mb-8 md:mb-16 text-slate-100 text-center md:text-left">My Journey</h2>
                
                <div class="space-y-8 md:space-y-12 border-l-2 border-slate-700 pl-6 md:pl-10 ml-2 md:ml-0">
                    <JourneyItem 
                        year="[2026 - Present]"
                        role="Owner"
                        company="moestdio"
                        description="bla bla bla ble ble ble eosithpiosentyiopsedhytiopsehtyiopsedhts et"
                        color="indigo"
                    />

                                        <JourneyItem 
                        year="[2025 - Present]"
                        role="Owner"
                        company="moestdio"
                        description="bla bla bla ble ble ble eosithpiosentyiopsedhytiopsehtyiopsedhts et"
                        color="cyan"
                    />

                                        <JourneyItem 
                        year="[2024 - Present]"
                        role="Owner"
                        company="moestdio"
                        description="bla bla bla ble ble ble eosithpiosentyiopsedhytiopsehtyiopsedhts et"
                        color="emerald"
                    />
                </div>
            </div>
        </section>

        <section class="min-h-dvh w-full flex flex-col justify-center snap-center px-6 pt-24 pb-6 md:px-8 md:py-24 relative snap-target">
            <div class="max-w-3xl mx-auto w-full text-center">
                <h2 class="text-[clamp(2.5rem,6vw,5rem)] font-bold mb-4 md:mb-6 bg-linear-to-br from-white to-slate-400 bg-clip-text text-transparent">Let's build something.</h2>
                <p class="text-lg md:text-xl text-slate-400 mb-8 md:mb-12 max-w-xl mx-auto leading-snug md:leading-relaxed">
                    CLOSING STATEMENT HAVENT DECIDED YET
                </p>
                <a href="mailto:moe@moestdio.com" class="inline-flex items-center gap-3 bg-white text-slate-900 font-bold px-6 py-3 md:px-8 md:py-4 rounded-full hover:scale-105 active:scale-95 hover:bg-indigo-500 active:bg-indigo-600 hover:text-white transition-all duration-300 shadow-xl shadow-white/10 hover:shadow-indigo-500/25 group focus:outline-none">
                    Get in Touch
                    <Icon name="lucide:chevron-down" class="w-4 h-4 md:w-5 md:h-5 -rotate-90 group-hover:translate-x-1 group-active:translate-x-1 transition-transform" />
                </a>
            </div>
        </section>

    </main>
</BaseLayout>