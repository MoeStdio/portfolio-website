---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BackgroundGlow from "../components/BackgroundGlow.astro";
---

<BaseLayout title="Projects | moestdio">
    <main
        class="min-h-screen pt-16 md:pt-32 touch-none snap-loading relative overflow-hidden"
    >
        <BackgroundGlow position="fixed" />

        <ProjectCard
            title="Wobbly Employee"
            coverText="Wobbly Employee | Cover"
            reverse={false}
            tags={[
                { text: "Roblox Studio", color: "indigo" },
                { text: "3D", color: "amber" },
                { text: "WIP", color: "cyan" },
            ]}
        >
            <p>
                A physics-comedy game where every object has almost no mass or
                friction, turning simple office tasks into chaotic disasters.
                You play as an employee climbing the corporate ladder by
                completing tasks and getting promoted to increasingly unhinged
                workplaces. I'm building the physics interactions, task systems,
                and progression mechanics from scratch.
            </p>
        </ProjectCard>

        <ProjectCard
            title="Moestdio.com"
            coverText="Moestdio.com | Cover"
            reverse={true}
            tags={[
                { text: "Web Development", color: "emerald" },
                { text: "Astro", color: "amber" },
            ]}
        >
            <p>
                My personal site and dev sandbox — built from scratch with
                Astro, deployed via GitHub Actions to a self-managed VPS running
                Caddy. A space to showcase what I'm building and experiment
                without the constraints of a "finished" product.
            </p>
        </ProjectCard>
    </main>
</BaseLayout>
