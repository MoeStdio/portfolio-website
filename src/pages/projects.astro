---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Lorem from '../components/Lorem.astro';
---

<BaseLayout title="Projects | moestdio">
    <main class="min-h-screen pt-24 md:pt-32 touch-none snap-loading">

        <ProjectCard 
            title="Project One"
            coverText="Project One Cover"
            reverse={false}
        >
            <Lorem />
        </ProjectCard>

        <ProjectCard 
            title="Project Two"
            coverText="Project Two Cover"
            reverse={true}
        >
            <Lorem />
        </ProjectCard>

        <ProjectCard 
            title="Project Three"
            coverText="Project Three Cover"
            reverse={false}
        >
            <Lorem />
        </ProjectCard>

    </main>

</BaseLayout>