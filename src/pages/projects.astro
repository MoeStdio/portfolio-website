---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Lorem from '../components/Lorem.astro';
---

<BaseLayout title="Projects | moestdio">
    <main class="min-h-screen pt-16 md:pt-32 touch-none snap-loading">

        <ProjectCard 
            title="Project One"
            coverText="Project One Cover"
            reverse={false}
            tags={[
                { text: 'Web App', color: 'indigo' },
                { text: 'Astro', color: 'slate' },
                { text: 'Tailwind', color: 'cyan' }
            ]}
        >
            <Lorem />
        </ProjectCard>

        <ProjectCard 
            title="Project Two"
            coverText="Project Two Cover"
            reverse={true}
            tags={[
                { text: 'Game', color: 'emerald' },
                { text: 'Animations', color: 'amber' }
            ]}
        >
            <Lorem />
        </ProjectCard>

        <ProjectCard 
            title="Project Three"
            coverText="Project Three Cover"
            reverse={false}
            tags={['UI Design', 'Figma']}
        >
            <Lorem />
        </ProjectCard>

    </main>

</BaseLayout>