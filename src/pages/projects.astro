---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Lorem from '../components/Lorem.astro';
---

<BaseLayout title="Projects | moestdio">
    <main class="min-h-screen pt-24 md:pt-32 touch-none">

        <div class="absolute top-24 md:top-32 w-full z-10 pointer-events-none">
            <h1 class="text-3xl md:text-6xl font-bold tracking-tight text-center text-amber-50/60">My Sandbox</h1>
        </div>

        <!-- Project 1 -->
        <ProjectCard 
            title="Project One"
            coverText="Project One Cover"
            reverse={false}
        >
            <Lorem />
        </ProjectCard>

        <!-- Project 2 -->
        <ProjectCard 
            title="Project Two"
            coverText="Project Two Cover"
            reverse={true}
        >
            <Lorem />
        </ProjectCard>

        <!-- Project 3 -->
        <ProjectCard 
            title="Project Three"
            coverText="Project Three Cover"
            reverse={false}
        >
            <Lorem />
        </ProjectCard>

    </main>

</BaseLayout>