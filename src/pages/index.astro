---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Home | moestdio">
	<section
		id="home"
		class="min-h-screen flex flex-col items-center justify-center p-6 relative snap-target overflow-hidden"
	>
		<div
			class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] md:w-[800px] md:h-[800px] bg-indigo-600/20 rounded-full blur-[100px] md:blur-[120px] pointer-events-none -z-10 will-change-transform transform-gpu"
		>
		</div>
		<div
			class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] md:w-[600px] md:h-[600px] bg-cyan-500/10 rounded-full blur-[80px] md:blur-[100px] pointer-events-none -z-10 translate-x-1/4 -translate-y-1/4 will-change-transform transform-gpu"
		>
		</div>

		<div
			class="max-w-4xl mx-auto w-full text-center z-10 flex flex-col items-center"
		>
			<div class="reveal mb-6 md:mb-8">
				<span
					class="inline-flex items-center gap-2 px-3 py-1 md:px-4 md:py-1.5 rounded-full bg-indigo-100 dark:bg-indigo-500/10 border border-indigo-200 dark:border-indigo-500/20 text-indigo-700 dark:text-indigo-300 text-xs md:text-sm font-medium"
				>
					<span class="relative flex h-2 w-2">
						<span
							class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-500 dark:bg-indigo-400 opacity-75"
						></span>
						<span
							class="relative inline-flex rounded-full h-2 w-2 bg-indigo-600 dark:bg-indigo-500"
						></span>
					</span>
					Available
				</span>
			</div>

			<h1
				class="reveal text-[clamp(2.5rem,8vw,6rem)] font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 via-indigo-500 to-cyan-500 dark:from-emerald-400 dark:via-white dark:to-cyan-400 leading-tight mb-6 tracking-tight box-decoration-clone"
			>
				Code. Nature. <br class="hidden md:block" /> Games.
			</h1>

			<p
				class="reveal text-[clamp(0.875rem,3vw,1.25rem)] text-slate-600 dark:text-slate-300 max-w-2xl mx-auto mb-10 md:mb-14 leading-relaxed"
			>
				Hi, I'm Moe. I'm an aspiring game developer and programmer who
				loves the outdoors. I craft interactive experiences and build
				worlds using Godot and Roblox Studio.
			</p>

			<div
				class="reveal flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto"
			>
				<a
					href="/projects"
					class="w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 dark:hover:bg-indigo-500 text-white px-8 py-4 rounded-full font-bold transition-all duration-300 hover:shadow-[0_0_20px_rgba(79,70,229,0.4)] hover:-translate-y-1 active:translate-y-0 active:scale-95 text-center"
				>
					View Projects
				</a>
				<a
					href="/about"
					class="w-full sm:w-auto bg-slate-100 dark:bg-slate-800/50 hover:bg-slate-200 dark:hover:bg-slate-800 border border-slate-300 dark:border-slate-700 hover:border-slate-400 dark:hover:border-slate-500 text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white px-8 py-4 rounded-full font-bold transition-all duration-300 backdrop-blur-sm hover:-translate-y-1 active:translate-y-0 active:scale-95 text-center"
				>
					About Me
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
