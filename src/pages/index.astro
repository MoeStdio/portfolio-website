		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>moestdio</title>

		<link rel="icon" href="/favicon.png" type="image/png">
	</head>

	<body class="bg-slate-900 text-slate-100 font-sans">
		<section id="home" class="min-h-screen flex flex-col items-center justify-center p-6 gap-6">

			<h1 class="text-6xl font-bold text-center">
				moestdio
			</h1>

			<p class="text-xl text-slate-400 text-center max-w-xl">
				Personal portfolio and sandbox currently in development.
			</p>

			<a href="#projects" class="bg-indigo-600 hover:bg-indigo-500 px-8 py-3 rounded-full font-semibold transition-colors">
				View Projects
			</a>

		</section>

		<section id="about" class="bg-slate-800 py-24 px-6">
			<div class="max-w-3xl mx-auto">
